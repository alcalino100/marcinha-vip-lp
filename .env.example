# ==========================================
# CONFIGURAÇÃO SUPABASE (Opcional / Recomendado)
# ==========================================
# URL do seu projeto no Supabase (ex: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Chave Anônima Pública (Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chave Secreta Service Role (Project Settings -> API -> service_role secret)
# Necessária para gravar visitas e upload de fotos contornando RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
